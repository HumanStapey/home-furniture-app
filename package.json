{
  "name": "home-furniture-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --workspace @home-furniture/frontend",
    "dev:backend": "npm run dev --workspace @home-furniture/backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:docker": "node --test scripts/verify-docker.cjs",
    "test:docker:restart": "node --test scripts/verify-docker-restart.cjs",
    "migration:show": "npm run migration:show --workspace @home-furniture/backend",
    "migration:run": "npm run migration:run --workspace @home-furniture/backend",
    "migration:revert": "npm run migration:revert --workspace @home-furniture/backend",
    "seed": "npm run seed --workspace @home-furniture/backend",
    "build": "npm run build --workspace @home-furniture/backend && npm run build --workspace @home-furniture/frontend"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/contracts"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
